```groovy
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Satendra-Devops/docker-website-cicd.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mywebsite:latest .'
            }
        }

        stage('Deploy Website') {
            steps {
                sh '''
                    docker rm -f mywebsite-container || true

                    docker run -d \
                        --name mywebsite-container \
                        --restart unless-stopped \
                        -p 80:80 \
                        mywebsite:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'Website deployed successfully!'
        }

        failure {
            echo 'Deployment failed. Check the Console Output.'
        }
    }
}
```
